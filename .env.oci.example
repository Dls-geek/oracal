# Copy to .env.oci and fill in YOUR values. Never commit .env.oci.
# cp .env.oci.example .env.oci

# Required after you create the A10 instance in the Console
INSTANCE_OCID=ocid1.instance.oc1..REPLACE_ME
COMPARTMENT_OCID=ocid1.compartment.oc1..REPLACE_ME
TENANCY_OCID=ocid1.tenancy.oc1..REPLACE_ME

# Home region from signup (Free Trial is usually one region only)
HOME_REGION=ap-singapore-1

# SSH into the VM (ubuntu for Ubuntu images, opc for Oracle Linux)
SSH_USER=ubuntu
SSH_KEY=~/.ssh/id_ed25519
# Optional: leave empty to discover from the instance VNIC
PUBLIC_IP=

# Free Trial clock — from Billing → Subscription (start date)
TRIAL_START=YYYY-MM-DD
TRIAL_DAYS=30
TRIAL_CREDITS_USD=300

# Used to estimate remaining GPU hours from credit balance
A10_USD_PER_HOUR=2.00

# Optional OCI CLI profile name (default: DEFAULT)
# OCI_CLI_PROFILE=DEFAULT
